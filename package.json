{
  "name": "aethon-beacon-app",
  "version": "1.0.2",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit",
    "start": "node scripts/with-build-id.mjs expo start",
    "android": "node scripts/with-build-id.mjs expo run:android",
    "android:dev": "node scripts/with-build-id.mjs expo start --dev-client --android",
    "ios": "node scripts/with-build-id.mjs expo run:ios",
    "ios:dev": "node scripts/with-build-id.mjs expo start --dev-client --ios",
    "web": "node scripts/with-build-id.mjs expo start --web",
    "export:web": "node scripts/with-build-id.mjs expo export --platform web && node scripts/copy-public-web.mjs",
    "doctor": "expo-doctor",
    "verification:server": "node scripts/verification-server.mjs",
    "verification:env-check": "node scripts/verification-env-check.mjs",
    "verification:qa": "node scripts/verification-qa.mjs",
    "dev:launch": "node scripts/dev-launch.mjs",
    "run:android": "node scripts/with-build-id.mjs expo run:android",
    "run:ios": "node scripts/with-build-id.mjs expo run:ios"
  },
  "dependencies": {
    "@expo/log-box": "56.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~56.0.0",
    "expo-asset": "~56.0.17",
    "expo-audio": "^56.0.12",
    "expo-constants": "56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-notifications": "^56.0.15",
    "expo-speech": "~56.0.3",
    "expo-store-review": "~56.0.3",
    "expo-updates": "~56.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "~0.21.0",
    "resolve": "1.22.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "56.0.15",
    "expo-doctor": "^1.17.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
