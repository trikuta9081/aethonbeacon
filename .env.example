# Aethon Beacon public Expo runtime config
# Copy to .env locally or add these to EAS/Sites/Vercel/hosting env.

EXPO_PUBLIC_VERIFICATION_API_BASE_URL=https://aethon-beacon-verification.onrender.com

# Verification service runtime settings. Public launch requires at least one
# real provider lane below; never enable LOCAL_VERIFICATION_DEBUG in production.
VERIFICATION_HOST=0.0.0.0
VERIFICATION_CORS_ORIGIN=https://nayiq.co,https://aethon-beacon-web.onrender.com
LOCAL_VERIFICATION_DEBUG=0
# Option A: Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Option B: SendGrid email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=NAYIQ
# Or use an internal HTTPS delivery adapter instead of Twilio/SendGrid.
VERIFICATION_SMS_WEBHOOK_URL=
VERIFICATION_EMAIL_WEBHOOK_URL=

# Required for realtime Community feed/chat
EXPO_PUBLIC_SUPABASE_URL=https://isfkxmrathirqkrwfagg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_x2hdByZdsmU26qPDuy5pZA_1PztSSwv

# Optional: visible build marker
EXPO_PUBLIC_BUILD_ID=local-dev

# Tester intake / auto-provisioning
TESTER_REQUEST_NOTIFY_EMAIL=slathiarimple567@gmail.com
# Optional: email tester requests via the same SendGrid settings above
# Optional Android auto-add: requires Google Workspace Admin SDK / domain-wide delegation
GOOGLE_TESTER_GROUP_EMAIL=
GOOGLE_GROUP_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_SUBJECT=
# Optional iOS auto-add: App Store Connect API key and beta group id
APPSTORE_API_KEY_ID=
APPSTORE_API_ISSUER_ID=
APPSTORE_API_KEY_P8=
APPSTORE_BETA_GROUP_ID=
