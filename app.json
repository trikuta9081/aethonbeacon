{
  "expo": {
    "name": "Aethon Beacon",
    "slug": "aethon-beacon",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "aethonbeacon",
    "backgroundColor": "#0A0F1E",
    "primaryColor": "#63DED0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aethon.beacon",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aethon Beacon does not use your camera.",
        "NSMicrophoneUsageDescription": "Aethon Beacon does not use your microphone.",
        "NSPhotoLibraryUsageDescription": "Aethon Beacon does not access your photo library.",
        "NSContactsUsageDescription": "Aethon Beacon does not access your contacts.",
        "NSLocationWhenInUseUsageDescription": "Aethon Beacon does not use your location.",
        "NSUserTrackingUsageDescription": "Aethon Beacon does not track you across apps or websites.",
        "UIRequiresPersistentWiFi": false,
        "NSFaceIDUsageDescription": "Use Face ID to protect your Aethon Beacon data."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.aethon.beacon",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/aethon-beacon-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "privacyPolicyUrl": "https://trikuta9081.github.io/aethonbeacon/privacy-policy.html",
      "supportEmail": "trikuta9081@gmail.com",
      "eas": {
        "projectId": "c9c6e5ac-336f-49e0-8dfa-f725aeaf8442"
      }
    },
    "owner": "trikuta",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c9c6e5ac-336f-49e0-8dfa-f725aeaf8442"
    },
    "runtimeVersion": "1.0.2"
  }
}
