{
  "expo": {
    "name": "NAYIQ",
    "slug": "aethon-beacon",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/nayiq-logo.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "aethonbeacon",
      "nayiq"
    ],
    "backgroundColor": "#0A0F1E",
    "primaryColor": "#63DED0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aethonbeacon.app",
      "buildNumber": "54",
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "NAYIQ does not use your camera.",
        "NSMicrophoneUsageDescription": "NAYIQ uses the microphone when you choose voice input for guidance and journaling.",
        "NSSpeechRecognitionUsageDescription": "NAYIQ uses speech recognition to transcribe voice input into text on supported devices.",
        "NSPhotoLibraryUsageDescription": "NAYIQ does not access your photo library.",
        "NSContactsUsageDescription": "NAYIQ does not access your contacts.",
        "NSLocationWhenInUseUsageDescription": "NAYIQ does not use your location.",
        "NSUserTrackingUsageDescription": "NAYIQ does not track you across apps or websites.",
        "UIRequiresPersistentWiFi": false,
        "NSFaceIDUsageDescription": "Use Face ID to protect your NAYIQ data."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "icon": "./assets/nayiq-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/nayiq-logo.png",
        "backgroundColor": "#07182A"
      },
      "package": "com.aethonbeacon.app",
      "versionCode": 21,
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/nayiq-logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow NAYIQ to use the microphone when you choose voice input.",
          "speechRecognitionPermission": "Allow NAYIQ to transcribe your voice input into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "privacyPolicyUrl": "https://aethon-beacon-web.onrender.com/privacy-policy.html",
      "supportEmail": "trikuta9081@gmail.com",
      "eas": {
        "projectId": "c9c6e5ac-336f-49e0-8dfa-f725aeaf8442"
      }
    },
    "owner": "trikuta",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c9c6e5ac-336f-49e0-8dfa-f725aeaf8442"
    },
    "runtimeVersion": "1.0.4"
  }
}
