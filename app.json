{
  "expo": {
    "name": "Aethon Beacon",
    "slug": "aethon-beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "aethonbeacon",
    "backgroundColor": "#0A0F1E",
    "primaryColor": "#63DED0",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aethon.beacon",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aethon Beacon does not use your camera.",
        "NSMicrophoneUsageDescription": "Aethon Beacon does not use your microphone.",
        "NSPhotoLibraryUsageDescription": "Aethon Beacon does not access your photo library.",
        "NSContactsUsageDescription": "Aethon Beacon does not access your contacts.",
        "NSLocationWhenInUseUsageDescription": "Aethon Beacon does not use your location.",
        "NSUserTrackingUsageDescription": "Aethon Beacon does not track you across apps or websites.",
        "UIRequiresPersistentWiFi": false,
        "NSFaceIDUsageDescription": "Use Face ID to protect your Aethon Beacon data."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.aethon.beacon",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan"
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#63DED0",
          "defaultChannel": "aethon-reminders",
          "sounds": []
        }
      ],
      "expo-store-review",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://YOUR_USERNAME.github.io/aethon-beacon/privacy-policy.html",
      "supportEmail": "trikuta9081@gmail.com"
    },

    "owner": "REPLACE_WITH_YOUR_EXPO_USERNAME",

    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/REPLACE_WITH_YOUR_EAS_PROJECT_ID"
    },

    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
